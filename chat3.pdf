      66 + * Deletes a category, which the backend blocks if any receipt 
         +still uses it.                                                 
      67 + *                                                             
      68 + * @returns The TanStack Query mutation for triggering and obse
         +rving the delete.                                              
      69 + */                                                            
      70 +export function useDeleteCategory() {                          
      71 +  const queryClient = useQueryClient();                        
      72 +  return useMutation({                                         
      73 +    mutationFn: (categoryId: number) => categoryService.remove(
         +categoryId),                                                   
      74 +    onSuccess: () => invalidateCategoryQueries(queryClient),   
      75 +  });                                                          
      76 +}                                                              

